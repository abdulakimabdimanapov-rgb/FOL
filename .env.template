# ——————————————————————————————————————————————————————————
# FOL — Environment Configuration (FREE Edition)
# https://github.com/23jmo/second-self
# ——————————————————————————————————————————————————————————
# Quick start:
#   1. Copy this file:    cp .env.template .env
#   2. Add your API keys below (no local models needed)
#   3. Run the pipeline:  python3 main.py --dry-run --tavily-only
# ——————————————————————————————————————————————————————————

# === LLM Provider (choose ONE) ===
# FOL does NOT run local LLMs (Ollama / MLX inference are removed by policy —
# no local inference, no hardware heating). Use an API provider:
#
# Free-tier API options (need sign-up):
#   openrouter/nvidia/nemotron-3-super-120b-a12b:free — OpenRouter free
#   groq/llama3-70b-8192   — Groq (free tier, ~30 req/min)
#   gemini/gemini-2.0-flash — Google (free tier, 60 req/min)
#   deepseek-chat          — DeepSeek ($0.14/million tokens)
#   xai/grok-3             — xAI Grok (paid)
#
# Paid options:
#   claude-sonnet-4-20250514     — Anthropic Claude
#   gpt-4o-mini                  — OpenAI
# Freebuff models via OpenRouter (recommended — free, fast):
#   openrouter/deepseek/deepseek-v4-flash  — DeepSeek V4 Flash (free)
#   openrouter/moonshotai/mimo-2.5         — MiMo 2.5 (free)
#   openrouter/nvidia/nemotron-3-super-120b-a12b:free — Nemotron (free)
LLM_MODEL=openrouter/deepseek/deepseek-v4-flash

# Set the API key for your chosen provider:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# === Optional LLM tuning ===
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0

# Optional fallback chain — comma-separated models tried in order when the
# primary is unavailable (provider outage, exhausted free quota, 404, …).
# Models without a configured API key are skipped automatically, so the
# assistant keeps working as long as at least one provider is available.
#   openrouter/nvidia/nemotron-3-ultra-550b-a55b:free — cloud fallback
LLM_FALLBACK_MODELS=openrouter/moonshotai/mimo-2.5,openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Optional per-call timeout in seconds (applies to every provider/model)
# LLM_TIMEOUT=60

# === Brain Backend ===
# FOL_BRAIN selects the reasoning brain:
#   current      (default) — uses LLM_MODEL with fallback chain
#   freebuff     — uses Freebuff models via OpenRouter as primary brain
#                  (OpenRouter API key required, models are free)
#   freebuff_tmux — uses Freebuff CLI via tmux (recommended for local Freebuff)
#                   (requires: brew install tmux + freebuff on PATH)
#   freebuff_cli — DEPRECATED: PTY-based, broken for React TUIs
FOL_BRAIN=current
# FOL_BRAIN_MODEL override (only for freebuff brain):
# FOL_BRAIN_MODEL=openrouter/deepseek/deepseek-v4-flash

# === Freebuff CLI PTY Bridge (when FOL_BRAIN=freebuff_cli) ===
# DEPRECATED: PTY-based approach is broken for React TUIs.
# Use freebuff_tmux instead.
FREEBUFF_BINARY=freebuff
# FREEBUFF_CWD=/path/to/project
FREEBUFF_AUTO_START=true
FREEBUFF_START_TIMEOUT=15
FREEBUFF_RESPONSE_TIMEOUT=300
FREEBUFF_SETTLE_MS=1500
FREEBUFF_RESTART_ATTEMPTS=2

# === Freebuff Tmux Bridge (when FOL_BRAIN=freebuff_tmux) ===
# Requires: brew install tmux + freebuff on PATH
FREEBUFF_TMUX_SESSION=fol-freebuff
# FREEBUFF_TMUX_COLS=120
# FREEBUFF_TMUX_ROWS=40

# === Google OAuth (for Gmail + Calendar — OPTIONAL, skip for free mode) ===
GOOGLE_REDIRECT_URI=http://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Tavily API (web search — OPTIONAL, skip for free mode) ===
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# === Your Profile (for Tavily search queries) ===
USER_NAME=
USER_EMAIL=

# === Server ===
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# === Firebase (for web app — OPTIONAL) ===
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Obsidian Local REST API (get your key from the Local REST API plugin settings)
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=~/Obsidian/FOL

# Shared Brain vault — общая память приложения FOL и всех AI-ассистентов
# (Profile/ Goals/ Models/ Conversations). FOL читает и дополняет этот vault.
FOL_BRAIN_VAULT=~/Obsidian/Brain
