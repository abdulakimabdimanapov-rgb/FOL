# FOL v1.0-beta — пример конфигурации.
# Скопируй в .env и заполни нужные ключи: cp .env.example .env

# ================= LLM (LiteLLM) =================
# Модель можно менять одной строкой. Примеры (только API-провайдеры —
# локальные LLM удалены из FOL политикой: без локального инференса,
# без нагрева железа):
#   Бесплатно (OpenRouter, 120B MoE — отличный tool calling):
#     LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
#   Платно:
#     LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Лимит токенов ответа (учитывай баланс провайдера)
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0

# ================= API Key Pool (автоматическая ротация) =================
# Когда один ключ исчерпывает лимит, FOL автоматически переключается
# на следующий доступный ключ. Ключи возвращаются после cooldown.
# Поддерживается до 99 ключей: OPENROUTER_API_KEY, _KEY_2, _KEY_3, ...
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# OPENROUTER_API_KEY_4=
# OPENROUTER_API_KEY_5=
# ... up to 99 keys

# Или через запятую (альтернатива):
# OPENROUTER_KEYS=sk-aaa,sk-bbb,sk-ccc

# Время cooldown для исчерпанного ключа (секунды, по умолчанию 300 = 5 мин)
OPENROUTER_KEY_COOLDOWN=300

# Ключи других провайдеров (нужен только для выбранной модели)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ================= Поиск и память =================
# Tavily (веб-поиск для сценария «найди информацию»)
TAVILY_API_KEY=

# Obsidian Local REST API (живая память)
# Установи плагин Local REST API в Obsidian, скопируй ключ и путь vault
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=/Users/you/Obsidian/FOL

# ================= Голос (STT) =================
# STT провайдеры (Speech-to-Text — голос → текст):
#   mlx_whisper (по умолчанию) — локальный, без API ключа, Apple Silicon
#   groq       — Groq Whisper API (быстро, бесплатно ~30 req/min)
#   elevenlabs — ElevenLabs Scribe (платный)
FOL_STT_PROVIDER=mlx_whisper

# Groq Whisper (бесплатный, быстрый, 99+ языков)
# Получи ключ: https://console.groq.com
GROQ_API_KEY=

# ElevenLabs (опционально, платный)
ELEVENLABS_API_KEY=

# ================= Google (почта, календарь) =================
# OAuth через Next.js (см. src/auth). Нужен для Gmail и Google Calendar.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ================= Интерфейс =================
# Тема GUI лаунчера: dark / light
FOL_THEME=dark

# ================= Сервер =================
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false

# ================= Brain (BrainInterface) =================
#   current      — LiteLLMRouter, API-провайдеры (OpenRouter/OpenAI/Anthropic)
#                  — DEFAULT, working.
#   freebuff     — Freebuff как основной мозг (автозапуск Freebuff CLI).
#                  Freebuff запускается в фоне при старте FOL.
#                  Fallback на current при ошибке.
#   freebuff_oll — Freebuff через OpenRouter (бесплатные модели).
#                  Автозапуск не нужен — работает через API.
FOL_BRAIN=current

# ================= Freebuff Auto-Start Bridge =================
# Freebuff автоматически запускается в фоне когда FOL стартует.
# Используется как основной brain с fallback на current.
FREEBUFF_AUTO_START=true
FREEBUFF_START_TIMEOUT=15
FREEBUFF_RESPONSE_TIMEOUT=300
FREEBUFF_RESTART_ATTEMPTS=2

# ================= Freebuff Models (бесплатно через OpenRouter) =================
# Freebuff использует эти модели — они доступны через OpenRouter:
#   DeepSeek V4 Flash — быстрый, бесплатный (limited mode)
#   MiMo 2.5 — сбалансированный, бесплатный (limited mode)
#   DeepSeek V4 Pro — глубокий reasoning (платный через OpenRouter)
# Пример цепочки:
#   LLM_MODEL=openrouter/deepseek/deepseek-v4-flash
#   LLM_FALLBACK_MODELS=openrouter/moonshotai/mimo-2.5,openrouter/nvidia/nemotron-3-super-120b-a12b:free
#
# Если FOL_BRAIN=freebuff, используется как основной мозг:
#   1. Freebuff CLI запускается в фоне (если FREEBUFF_AUTO_START=true)
#   2. Все запросы идут через Freebuff
#   3. При ошибке — fallback на current (LLM_MODEL)
#   4. Freebuff автоматически перезапускается при падении
