# F.O.L. Environment Configuration

# General
FOL_DEBUG=false
FOL_LOG_LEVEL=INFO
FOL_DATA_DIR=~/.fol

# STT (Speech-to-Text)
FOL_STT_MODEL=medium
FOL_STT_DEVICE=mps
FOL_STT_LANGUAGE=ru

# LLM — options: openrouter | openai | anthropic (NO local LLMs — policy:
# FOL does not run Ollama / MLX inference, no hardware heating)
FOL_LLM_BACKEND=openrouter
# Freebuff models via OpenRouter (recommended — free, fast):
#   openrouter/deepseek/deepseek-v4-flash  — DeepSeek V4 Flash (free)
#   openrouter/moonshotai/mimo-2.5         — MiMo 2.5 (free)
FOL_LLM_MODEL=openrouter/deepseek/deepseek-v4-flash
FOL_LLM_MAX_TOKENS=4096
FOL_LLM_TEMPERATURE=0.7

# OpenAI (optional)
FOL_OPENAI_API_KEY=
FOL_OPENAI_MODEL=gpt-4o-mini

# OpenRouter (optional, OpenAI-compatible) — free models like Nemotron 550B
FOL_OPENROUTER_API_KEY=
FOL_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FOL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Memory
FOL_MEMORY_VECTOR_DB_PATH=~/.fol/vector_db
FOL_MEMORY_MAX_RESULTS=10

# API
FOL_API_HOST=127.0.0.1
FOL_API_PORT=8754

# Brain backend (BrainInterface selection)
#   current   — LiteLLMRouter, API providers only (OpenRouter/OpenAI/Anthropic)
#               — DEFAULT, working.
